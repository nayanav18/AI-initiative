# ============================================================
# Enterprise Analytics AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================================

# Google Cloud Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# BigQuery Configuration
BIGQUERY_DATASET=your-dataset-name
BIGQUERY_LOCATION=US

# Vertex AI Configuration (used in future milestones)
VERTEX_AI_MODEL=gemini-2.5-flash-lite
VERTEX_AI_TEMPERATURE=0.2
VERTEX_AI_MAX_TOKENS=2048

# Application Configuration
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend URL for CORS (restrict in production)
FRONTEND_URL=http://localhost:5173

# Security — generate a strong random value for production
SECRET_KEY=change-this-to-a-secure-random-string
